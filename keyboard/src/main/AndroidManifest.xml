<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      AI 교정·번역, 구독 확인, 로그인에 쓴다. 글은 사용자가 AI 버튼을 누를 때만 나간다.
      온디바이스 교정은 이 권한 없이도 그대로 동작한다.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpellKeyboard">

        <service
            android:name=".SpellKeyboardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          키보드 맞춤설정. 더보기 서랍과 자판 도구 줄의 설정 버튼에서만 열리므로 밖으로
          내보내지 않는다.
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- 결제 화면. 첫 화면 안에서만 열리므로 밖으로 내보내지 않는다. -->
        <activity
            android:name=".PaywallActivity"
            android:exported="false"
            android:label="@string/app_name" />
    </application>

</manifest>
