<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      AI 교정·번역, 구독 확인, 로그인에 쓴다. 글은 사용자가 AI 버튼을 누를 때만 나간다.
      온디바이스 교정은 이 권한 없이도 그대로 동작한다.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      고성능 번역 모델(약 3GB)을 받을 때 와이파이인지 데이터인지 가려 데이터 요금이 나가지 않게 한다. 이 용도 하나뿐이다.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpellKeyboard">

        <service
            android:name=".SpellKeyboardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          키보드 맞춤설정. 더보기 서랍과 자판 도구 줄의 설정 버튼에서만 열리므로 밖으로
          내보내지 않는다.
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!--
          기기 안 번역 모델(고성능 번역). **별도 프로세스(:llm)** 에서 돈다 — 모델은 메모리를 2~3GB 쓰고 네이티브 코드는 가끔 죽는다.
          같은 프로세스면 키보드까지 같이 죽는다. 키보드가 연결을 맺을 때만 뜨고, 쉬면 스스로 프로세스째 끝난다.
        -->
        <service
            android:name=".llm.LlmService"
            android:exported="false"
            android:process=":llm" />

        <!-- 결제 화면. 첫 화면 안에서만 열리므로 밖으로 내보내지 않는다. -->
        <activity
            android:name=".PaywallActivity"
            android:exported="false"
            android:label="@string/app_name" />
    </application>

</manifest>
