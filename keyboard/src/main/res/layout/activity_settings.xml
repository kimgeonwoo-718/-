<?xml version="1.0" encoding="utf-8"?>
<!--
  키보드 맞춤설정. 더보기 화면과 자판 도구 줄의 설정 버튼에서 온다.
  실시간 교정 스위치와 자판 모양(종류·밝기·배경·투명도). 첫 화면과 같은 토스 톤을 쓴다.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/toss_bg"
    android:fillViewport="true"
    android:importantForAutofill="noExcludeDescendants"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/back_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/toss_text"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/toss_text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!--
          실시간 교정 켬/끔 스위치는 뺐다(2026-09-29, 사용자 결정 — 헷갈린다). 켜고 끄는 곳은 자판 위
          'LIVE' 동그라미 하나다. 두 군데 있으면 어느 쪽이 진짜인지 헷갈린다.
        -->
        <!-- 키보드 -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/section_keyboard" />

            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="@string/setting_layout" />
                </LinearLayout>
                <LinearLayout style="@style/Segment">
                    <TextView android:id="@+id/layout_qwerty" style="@style/SegmentItem" android:text="@string/setting_layout_qwerty" />
                    <TextView android:id="@+id/layout_cheonjiin" style="@style/SegmentItem" android:text="@string/setting_layout_cheonjiin" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="@string/setting_theme" />
                </LinearLayout>
                <LinearLayout style="@style/Segment">
                    <TextView android:id="@+id/theme_light" style="@style/SegmentItem" android:text="@string/setting_theme_light" />
                    <TextView android:id="@+id/theme_dark" style="@style/SegmentItem" android:text="@string/setting_theme_dark" />
                    <TextView android:id="@+id/theme_sealion" style="@style/SegmentItem" android:text="@string/setting_theme_sealion" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="@string/setting_background" />
                    <TextView android:id="@+id/background_status" style="@style/RowSub" />
                </LinearLayout>
                <TextView android:id="@+id/background_pick" style="@style/Pill" android:text="@string/setting_background_pick" />
                <TextView
                    android:id="@+id/background_clear"
                    style="@style/Pill"
                    android:layout_marginStart="6dp"
                    android:text="@string/setting_background_clear" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/setting_key_transparency" />

                    <TextView
                        android:id="@+id/key_transparency_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/toss_blue"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView style="@style/RowSub" android:text="@string/setting_key_transparency_sub" />

                <SeekBar
                    android:id="@+id/key_transparency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100" />
            </LinearLayout>
        </LinearLayout>

        <!-- 고성능 번역: 휴대폰 안에서 도는 AI 모델(제마 4)을 받아 쓴다. 받기 전에는 ML Kit 번역 그대로다. -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/section_llm" />

            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="@string/setting_llm_title" />
                    <TextView android:id="@+id/llm_status" style="@style/RowSub" />
                </LinearLayout>
                <TextView android:id="@+id/llm_action" style="@style/Pill" android:text="@string/setting_llm_get" />
                <TextView
                    android:id="@+id/llm_delete"
                    style="@style/Pill"
                    android:layout_marginStart="6dp"
                    android:text="@string/setting_llm_delete" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/llm_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginBottom="8dp"
                android:max="1000"
                android:visibility="gone" />

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row" android:id="@+id/llm_use_row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="@string/setting_llm_use" />
                    <TextView style="@style/RowSub" android:text="@string/setting_llm_use_sub" />
                </LinearLayout>
                <LinearLayout style="@style/Segment">
                    <TextView android:id="@+id/llm_on" style="@style/SegmentItem" android:text="@string/setting_llm_on" />
                    <TextView android:id="@+id/llm_off" style="@style/SegmentItem" android:text="@string/setting_llm_off" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/RowSub"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:text="@string/setting_llm_intro" />
            <TextView
                style="@style/RowSub"
                android:layout_marginBottom="12dp"
                android:text="@string/setting_llm_size" />
        </LinearLayout>

        <!-- 소리 (바다사자 소리팩은 구독자 전용) -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/section_sound" />

            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="@string/setting_key_sound" />
                    <TextView style="@style/RowSub" android:text="@string/setting_key_sound_sub" />
                </LinearLayout>
                <LinearLayout style="@style/Segment">
                    <TextView android:id="@+id/sound_none" style="@style/SegmentItem" android:text="@string/setting_sound_none" />
                    <TextView android:id="@+id/sound_sealion" style="@style/SegmentItem" android:text="@string/setting_sound_sealion" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/setting_sound_volume" />

                    <TextView
                        android:id="@+id/sound_volume_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/toss_blue"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sound_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Caption"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="4dp"
            android:text="@string/privacy_notice" />
    </LinearLayout>
</ScrollView>
