<?xml version="1.0" encoding="utf-8"?>
<!--
  첫 화면. 토스 톤 — 연회색 바탕에 흰 카드, 카드 안은 56dp 행.

  autofill 은 화면 통째로 끈다. 키보드 앱이 비밀번호 관리자를 불러내는 그림은 사용자를
  불안하게 만든다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:id="@+id/setup_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/toss_bg"
    android:fillViewport="true"
    android:importantForAutofill="noExcludeDescendants"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="40dp">

        <!--
          위 막대. 앱 이름과 ☰ 하나. 로그인·키보드 맞춤설정·약관·고객센터는 전부 ☰ 뒤
          더보기 화면에 모았다 — 버튼을 여기 늘어놓았더니 지저분하고 서로 따로 놀았다.
          본문에는 처음 온 사람이 할 일(시작하기 → 써 보기 → 사용법 → 프리미엄)만 남긴다.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/toss_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/menu_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="-10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/more_title"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_menu" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/home_subtitle"
            android:textColor="@color/toss_text2"
            android:textSize="15sp" />

        <!-- 시작하기 -->
        <LinearLayout
            android:id="@+id/setup_card"
            style="@style/Card">

            <TextView style="@style/CardTitle" android:text="@string/section_setup" />

            <TextView
                android:id="@+id/setup_all_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/setup_all_done"
                android:textColor="@color/toss_green"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="@string/setup_enable_title" />
                    <TextView style="@style/RowSub" android:text="@string/setup_enable_sub" />
                </LinearLayout>
                <TextView android:id="@+id/enable_button" style="@style/Pill" android:text="@string/setup_open" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="@string/setup_pick_title" />
                    <TextView style="@style/RowSub" android:text="@string/setup_pick_sub" />
                </LinearLayout>
                <TextView android:id="@+id/pick_button" style="@style/Pill" android:text="@string/setup_open" />
            </LinearLayout>
        </LinearLayout>

        <!-- 써 보기 -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/section_try" />
            <EditText
                android:id="@+id/test_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="@string/setup_test_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:padding="16dp"
                android:textColor="@color/toss_text"
                android:textColorHint="@color/toss_text3"
                android:textSize="16sp" />
        </LinearLayout>

        <!--
          사용법. 방금 써 본 바로 밑에 둔다 — 쳐 보다가 "이건 뭐지" 싶을 때 눈이 가는
          자리가 거기다. 도구 줄을 그림으로 그려 놓고 누른 자리를 막대기로 가리킨다.
        -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/section_guide" />
            <TextView
                style="@style/RowSub"
                android:layout_marginTop="6dp"
                android:text="@string/guide_intro" />

            <com.spellkeyboard.ko.ToolbarGuideView
                android:id="@+id/toolbar_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!--
          프리미엄. 무엇을 파는지와 사는 버튼만. 한도·데이터 안내 같은 잔글씨는 환경설정의
          정보 칸으로 옮겼다 — 여기서는 눈이 버튼에 가야 한다.
        -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/paywall_title_plan" />

            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="@string/setting_ai_title" />
                    <TextView style="@style/RowSub" android:text="@string/setting_ai_sub" />
                    <TextView
                        android:id="@+id/quota_output"
                        style="@style/RowSub"
                        android:textColor="@color/toss_blue"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/subscribe_button"
                style="@style/PrimaryButton"
                android:layout_marginTop="8dp"
                android:text="@string/setting_plan_subscribe" />

            <TextView
                android:id="@+id/billing_status"
                style="@style/Caption"
                android:layout_marginTop="10dp" />

            <TextView
                style="@style/Caption"
                android:layout_marginTop="6dp"
                android:text="@string/setting_plan_note" />

            <!-- AI 로 글이 나간다는 말은 AI 를 파는 자리에 있어야 한다. -->
            <TextView
                style="@style/Caption"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:text="@string/ai_notice" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

    <!--
      더보기 서랍이 열렸을 때 나머지를 어둡게 까는 막. 누르면 서랍이 닫힌다.
      clickable 이라 밑의 첫 화면에 손이 닿지 않는다.
    -->
    <View
        android:id="@+id/more_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:contentDescription="@string/more_close"
        android:focusable="false"
        android:visibility="gone" />

    <include layout="@layout/more_drawer" />
</FrameLayout>
