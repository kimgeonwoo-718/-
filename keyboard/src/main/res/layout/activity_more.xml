<?xml version="1.0" encoding="utf-8"?>
<!--
  더보기. 첫 화면 오른쪽 위 ☰ 에서 온다.

  위: 계정 칸 — 로그인 전에는 로그인 버튼, 뒤에는 구글 프로필 사진·이름과 로그아웃·회원 탈퇴.
  아래: 메뉴 — 키보드 맞춤설정, 개인정보 처리방침, 서비스 이용약관, 고객센터.
  맨 밑: 버전과 설치 ID(길게 눌러 복사). 문의할 때 필요하다.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/toss_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/back_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/toss_text"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/more_title"
                android:textColor="@color/toss_text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 계정. 빌드에 로그인 클라이언트 ID 가 없으면 칸째 숨는다(MoreActivity). -->
        <LinearLayout
            android:id="@+id/account_card"
            style="@style/Card"
            android:paddingBottom="18dp">

            <!-- 로그인 전 -->
            <LinearLayout
                android:id="@+id/account_signed_out"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/CardTitle" android:text="@string/account_title" />
                <TextView
                    style="@style/RowSub"
                    android:layout_marginTop="6dp"
                    android:text="@string/account_signin_sub" />
                <TextView
                    android:id="@+id/signin_button"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/account_signin" />
            </LinearLayout>

            <!-- 로그인 뒤: 사진 · 이름, 그 밑에 로그아웃 · 회원 탈퇴 -->
            <LinearLayout
                android:id="@+id/account_signed_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp">

                        <TextView
                            android:id="@+id/profile_initial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_avatar"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/profile_photo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/account_photo"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profile_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/toss_text"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/account_status"
                            style="@style/RowSub" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/signout_button"
                        style="@style/SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/account_signout" />

                    <TextView
                        android:id="@+id/delete_button"
                        style="@style/SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/account_delete"
                        android:textColor="@color/toss_red" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 메뉴 -->
        <LinearLayout
            style="@style/Card"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/menu_keyboard"
                style="@style/MenuRow"
                android:text="@string/menu_keyboard" />

            <View style="@style/Divider" />

            <TextView
                android:id="@+id/menu_privacy"
                style="@style/MenuRow"
                android:text="@string/menu_privacy" />

            <View style="@style/Divider" />

            <TextView
                android:id="@+id/menu_terms"
                style="@style/MenuRow"
                android:text="@string/menu_terms" />

            <View style="@style/Divider" />

            <TextView
                android:id="@+id/menu_support"
                style="@style/MenuRow"
                android:text="@string/menu_support" />
        </LinearLayout>

        <TextView
            android:id="@+id/app_info"
            style="@style/Caption"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="4dp"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
