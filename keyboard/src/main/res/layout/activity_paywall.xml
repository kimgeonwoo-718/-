<?xml version="1.0" encoding="utf-8"?>
<!--
  결제 화면. 챗GPT Plus 업그레이드 화면의 구조를 따른다 — 동그란 뒤로 가기, 큰 제목
  (요금제 이름만 파랗게), 무료|프리미엄 알약, 기능 비교표(✓ / — / 숫자), "구독 복원",
  검은 알약 버튼, 갱신 안내 한 줄.

  비교표의 줄들은 PaywallActivity 가 코드로 채운다. 숫자는 서버 한도에서 계산되므로
  여기 박아 두면 어긋난다. 제목의 파란 글자도 코드에서 칠한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/toss_card"
    android:importantForAutofill="noExcludeDescendants"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/paywall_back"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/paywall_back"
                android:textColor="@color/toss_text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/paywall_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textColor="@color/toss_text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/paywall_headline"
                android:textColor="@color/toss_text2"
                android:textSize="16sp" />

            <!-- 무료 | 프리미엄 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_plan_segment"
                android:orientation="horizontal"
                android:padding="2dp">
                <TextView
                    android:id="@+id/paywall_seg_free"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_plan_segment_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/paywall_col_free"
                    android:textColor="@color/toss_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/paywall_seg_premium"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_plan_segment_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/paywall_col_premium"
                    android:textColor="@color/toss_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 기능 비교표 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_outlined"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/paywall_col_features"
                        android:textColor="@color/toss_text3"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/paywall_col_free"
                        android:textColor="@color/toss_text3"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/paywall_col_premium"
                        android:textColor="@color/toss_blue"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/paywall_table"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/paywall_status"
                style="@style/Caption"
                android:layout_marginTop="12dp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>

    <!-- 아래 고정: 구독 복원 · 버튼 · 갱신 안내 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/toss_card"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/paywall_restore"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/paywall_restore"
            android:textColor="@color/toss_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/paywall_cta"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_button_black"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/paywall_cta_upgrade"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/paywall_footer"
            android:textColor="@color/toss_text3"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
