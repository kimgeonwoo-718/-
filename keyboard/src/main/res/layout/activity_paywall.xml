<?xml version="1.0" encoding="utf-8"?>
<!--
  결제 화면. 동그란 뒤로 가기, 제목 "프리미엄", 파란 값 칸("하루 99원!"), 무료와
  프리미엄을 나란히 놓은 비교표(✓ / ✗), "구독 복원", 검은 알약 버튼, 갱신 안내 한 줄.

  예전에는 제목 밑에 무료|프리미엄 알약이 있어서 눌러 볼 수 있었는데, 눌러도 아래
  버튼 글자만 바뀌었다. 고를 것이 없는 화면에 고르는 척하는 부품은 없느니만 못해서
  뺐다 — 비교는 표가 하고, 이 화면의 일은 "프리미엄이 무엇인가" 하나다.

  비교표의 줄들은 PaywallActivity 가 코드로 채운다. 횟수는 서버 한도에서 계산되므로
  여기 박아 두면 어긋난다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/toss_card"
    android:importantForAutofill="noExcludeDescendants"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/paywall_back"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/paywall_back"
                android:textColor="@color/toss_text"
                android:textSize="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/paywall_title_app"
                android:textColor="@color/toss_text3"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/paywall_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text="@string/paywall_title_plan"
                android:textColor="@color/toss_blue"
                android:textSize="34sp"
                android:textStyle="bold" />

            <!--
              값 칸. "하루 99원!" 을 이 화면에서 제일 큰 글씨로 박는다. 글꼴은 굵은 산세리프
              (sans-serif-black) — 숫자가 또렷하다. 한글은 기기 글꼴의 제일 굵은 굵기로 떨어진다.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_hero"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:text="@string/paywall_price_day"
                    android:textColor="#FFFFFF"
                    android:textSize="52sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="@string/paywall_price_coffee"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/paywall_price_month"
                    android:textColor="#D6E6FF"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 기능 비교표 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_outlined"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/paywall_col_features"
                        android:textColor="@color/toss_text3"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/paywall_col_free"
                        android:textColor="@color/toss_text3"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/paywall_col_premium"
                        android:textColor="@color/toss_blue"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/paywall_table"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/paywall_status"
                style="@style/Caption"
                android:layout_marginTop="12dp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>

    <!-- 아래 고정: 구독 복원 · 버튼 · 갱신 안내 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/toss_card"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/paywall_restore"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/paywall_restore"
            android:textColor="@color/toss_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/paywall_cta"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_button_black"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/paywall_cta_upgrade"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/paywall_footer"
            android:textColor="@color/toss_text3"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
