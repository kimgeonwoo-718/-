<?xml version="1.0" encoding="utf-8"?>
<!--
  둘러보기 맨 아래 고정 막대: 건너뛰기 · 몇 번째 · 다음(마지막엔 시작하기).
  어두운 덮개 위에 얹히므로 글씨는 희게. 설명 칸이 어디로 가든 이 막대는 늘 같은 자리다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/coach_skip"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="88dp"
        android:paddingHorizontal="12dp"
        android:text="@string/guide_skip"
        android:textColor="#E6FFFFFF"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/coach_step"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/coach_next"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/bg_button_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="104dp"
        android:paddingHorizontal="20dp"
        android:text="@string/guide_next"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
