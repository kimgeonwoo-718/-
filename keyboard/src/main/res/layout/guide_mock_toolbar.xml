<?xml version="1.0" encoding="utf-8"?>
<!--
  안내 화면에 넣는 흉내 도구 줄. 진짜 도구 줄과 같은 순서 · 같은 글자다:
  ▲ 접기 · ☺ 이모티콘 · ALL · 클립보드 · LIVE(파랗게 = 켜짐) · 번역 · ⚙ 설정.
  칸마다 id 가 있어서 CalloutLayout 이 아무 칸이나 동그라미 칠 수 있다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <FrameLayout style="@style/MockKeyCell">
        <TextView android:id="@+id/mock_collapse" style="@style/MockKey" android:background="@null" android:text="▲" android:textSize="9sp" />
    </FrameLayout>
    <FrameLayout style="@style/MockKeyCell">
        <TextView android:id="@+id/mock_emoji" style="@style/MockKey" android:text="☺︎" android:textSize="15sp" android:textStyle="normal" />
    </FrameLayout>
    <FrameLayout style="@style/MockKeyCell">
        <TextView android:id="@+id/mock_all" style="@style/MockKey" android:text="ALL" />
    </FrameLayout>
    <FrameLayout style="@style/MockKeyCell">
        <ImageView
            android:id="@+id/mock_clip"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mock_key"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_clipboard"
            android:tint="@color/toss_text" />
    </FrameLayout>
    <FrameLayout style="@style/MockKeyCell">
        <TextView android:id="@+id/mock_live" style="@style/MockKey" android:background="@drawable/bg_avatar" android:text="LIVE" android:textColor="#FFFFFF" />
    </FrameLayout>
    <FrameLayout style="@style/MockKeyCell">
        <TextView android:id="@+id/mock_translate" style="@style/MockKey" android:text="번역" />
    </FrameLayout>
    <FrameLayout style="@style/MockKeyCell">
        <TextView android:id="@+id/mock_settings" style="@style/MockKey" android:text="⚙︎" android:textSize="15sp" android:textStyle="normal" />
    </FrameLayout>
</LinearLayout>
