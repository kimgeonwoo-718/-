<?xml version="1.0" encoding="utf-8"?>
<!--
  둘러보기 설명 칸. 밝게 남긴 버튼에서 작대기가 이 칸으로 이어진다. 제목 · 설명만 —
  다음/건너뛰기는 화면 맨 아래 고정 막대(coach_controls)에 있다. 설명 칸 안에 두었더니 칸이
  화면 밖으로 밀려날 때 버튼까지 같이 사라져 넘어갈 수가 없었다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="16dp">

    <TextView
        android:id="@+id/coach_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/toss_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/coach_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/toss_text2"
        android:textSize="15sp" />
</LinearLayout>
