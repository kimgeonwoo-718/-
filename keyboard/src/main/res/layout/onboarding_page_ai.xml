<?xml version="1.0" encoding="utf-8"?>
<!--
  안내 3쪽: 짧게 누르면 기기 안에서 무료, 꾹 누르면 AI(프리미엄). ALL 과 번역 두 버튼.

  모든 쪽이 같은 뼈대다: 위쪽 남는 자리 한가운데에 흉내 화면을 크게 두고, 그 밑에 제목과 설명을
  가운데 맞춤으로 — 버튼 바로 위라 눈이 그림 → 글 → 버튼 순으로 내려온다. 처음엔 제목을 맨 위에
  두었더니 키 큰 폰에서 그림 밑이 휑하게 비었다. 화면이 작으면 통째로 스크롤된다.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.spellkeyboard.ko.CalloutLayout
                android:id="@+id/page_callout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginVertical="8dp"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        layout="@layout/guide_mock_toolbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/label_all"
                            style="@style/GuideLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/guide3_label_all" />

                        <TextView
                            android:id="@+id/label_translate"
                            style="@style/GuideLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/guide3_label_translate" />
                    </LinearLayout>

                    <TextView
                        style="@style/Caption"
                        android:layout_marginTop="14dp"
                        android:text="@string/guide3_note" />
                </LinearLayout>
            </com.spellkeyboard.ko.CalloutLayout>
        </FrameLayout>

        <TextView
            style="@style/GuideTitle"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/guide3_title" />

        <TextView
            style="@style/GuideSub"
            android:gravity="center"
            android:text="@string/guide3_sub" />
    </LinearLayout>
</ScrollView>
